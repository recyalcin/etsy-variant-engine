DB_PROFILE=-YOUR_SHOP_NAME
WRITE_ENABLED=false

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=YOUR_PASSWORD
MYSQL_DB=YOUR_DB_NAME

ETSY_API_KEY=YOUR_ETSY_API_KEY
ETSY_API_SECRET=YOUR_ETSY_API_SECRET
ETSY_REFRESH_TOKEN=YOUR_ETSY_REFRESH_TOKEN

# Optional AI-assisted variant analysis. The engine works without these.
AI_VARIANT_ENABLED=false
AI_VARIANT_MODE=necessary
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
